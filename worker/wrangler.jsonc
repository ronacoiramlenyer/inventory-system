{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inventory-system-api",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inventory-system-db",
      "database_id": "16584618-af06-4d7a-ad57-960e4b4994d9"
    }
  ],
  "vars": {
    // Where a filed F-LAB-004 Equipment Work Request gets emailed. Not
    // sensitive, so it's a plain var rather than a secret.
    "SECRETARY_EMAIL": "nina.sabellano@lsgh.edu.ph"
  }
  // JWT_SECRET and RESEND_API_KEY are intentionally not set here. For local
  // dev, copy .dev.vars.example to .dev.vars (gitignored). For the deployed
  // Worker, set them with `wrangler secret put <NAME>` — see worker/README.md.
}
