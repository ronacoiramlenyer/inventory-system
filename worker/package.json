{
  "name": "inventory-system-worker",
  "version": "1.0.0",
  "description": "Cloudflare Worker (Hono + D1) API for the laboratory inventory management system",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:schema:remote": "wrangler d1 execute inventory-system-db --remote --file=./src/db/schema.sql",
    "db:schema:local": "wrangler d1 execute inventory-system-db --local --file=./src/db/schema.sql"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
